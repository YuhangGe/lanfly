{
  "name": "lanfly",
  "version": "0.3.1",
  "description": "A lightweight all-in-one LAN toolkit: chat and file transfer with automatic peer discovery, Synergy-style keyboard/mouse sharing across Macs, and RustDesk-style remote desktop in the browser. No accounts, cloud, or central server.",
  "keywords": [
    "chat",
    "discovery",
    "file-transfer",
    "lan",
    "localsend"
  ],
  "homepage": "https://github.com/YuhangGe/lanfly",
  "bugs": {
    "url": "https://github.com/YuhangGe/lanfly/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuhangGe/lanfly.git"
  },
  "bin": {
    "lanfly": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/data.json",
    "!dist/data.json.*.tmp",
    "docs/lanfly.png",
    "changelog.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun script/build.ts",
    "build:native": "bun script/build-native.ts",
    "check": "pnpm lint",
    "dev": "bun script/dev.ts",
    "dev:server": "bun run --cwd packages/server dev",
    "dev:web": "bun run --cwd packages/webui dev",
    "lint": "tsc -b && oxfmt --check . && oxlint --type-aware .",
    "lint-fix": "oxlint --type-aware . --fix && oxfmt .",
    "lint:staged": "lint-staged",
    "pack:local": "bun run build && bun pm pack",
    "prepare": "husky",
    "prepublishOnly": "bun run check && bun run build",
    "remote-test": "bun script/remote-test.ts",
    "start": "bun dist/cli.js",
    "test": "bun test --timeout 30000 packages/server/test",
    "test:watch": "bun test --watch --timeout 30000 packages/server/test",
    "typecheck": "tsc -p tsconfig.json --noEmit && bun run --cwd packages/common typecheck && bun run --cwd packages/server typecheck && bun run --cwd packages/webui typecheck",
    "version": "bun script/sync-native-version.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "bun": "^1.4.4",
    "esbuild": "^0.28.2",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "lanfly-input-darwin-arm64": "0.3.1",
    "lanfly-input-darwin-x64": "0.3.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --type-aware --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,mjs,cjs,json,md,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0"
}
