{
  "name": "lanfly",
  "version": "0.1.0",
  "description": "A lightweight LAN messenger and file-transfer tool with automatic peer discovery.",
  "keywords": [
    "chat",
    "discovery",
    "file-transfer",
    "lan",
    "localsend"
  ],
  "license": "MIT",
  "bin": {
    "lanfly": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/lanfly.png"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun script/build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "dev": "bun script/dev.ts",
    "dev:server": "bun run --cwd packages/server dev",
    "dev:web": "bun run --cwd packages/webui dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware .",
    "pack:local": "bun run build && bun pm pack",
    "prepublishOnly": "bun run check && bun run build",
    "start": "bun dist/cli.js",
    "test": "bun test --timeout 30000 packages/server/test",
    "test:watch": "bun test --watch --timeout 30000 packages/server/test",
    "typecheck": "tsc -p tsconfig.json --noEmit && bun run --cwd packages/common typecheck && bun run --cwd packages/server typecheck && bun run --cwd packages/webui typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "bun": "^1.4.4",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0"
}
